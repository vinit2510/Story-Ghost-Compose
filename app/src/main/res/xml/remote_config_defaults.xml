<?xml version="1.0" encoding="utf-8"?>
<defaultsMap>
    <entry>
        <key>instagram_login_url</key>
        <value>https://www.instagram.com/accounts/login/</value>
    </entry>
    <entry>
        <key>instagram_account_url</key>
        <value>https://www.instagram.com/%s/</value>
    </entry>
    <entry>
        <key>force_update_version</key>
        <value>1</value>
    </entry>
    <!-- Make sure single line string -->
    <entry>
        <key>user_agent</key>
        <value>Mozilla/5.0 (iPhone; CPU iPhone OS 12_3_1 like Mac OS X) AppleWebKit/605.1.15 (KHTML,
            like Gecko) Mobile/15E148 Instagram 105.0.0.11.118 (iPhone11,8; iOS 12_3_1; en_US;
            en-US; scale=2.00; 828x1792; 165586599)
        </value>
    </entry>
    <entry>
        <key>cookie_min_version</key>
        <value>1</value>
    </entry>
</defaultsMap>
